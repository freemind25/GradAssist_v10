# ─────────────────────────────────────────────────────────────────────────────
# Modèle de configuration de signature Android — NE PAS VERSIONNER CE FICHIER
#
# Copier en `android/keystore.properties`, puis remplir les valeurs.
# Le fichier est déjà ignoré par git (android/.gitignore + .gitignore racine).
#
# En CI (GitHub Actions), ne pas créer ce fichier : renseigner les secrets
# ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS et
# ANDROID_KEY_PASSWORD. Voir SECURITY.md.
# ─────────────────────────────────────────────────────────────────────────────

# Chemin du keystore. Relatif à android/app/, ou absolu.
storeFile=gradeassist-release.keystore
storePassword=CHANGER_MOI
keyAlias=gradeassist
keyPassword=CHANGER_MOI
