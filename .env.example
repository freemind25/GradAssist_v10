# =========================================================================
# GradeAssist — Modèle de variables d'environnement
# [SEC-07 / SEC-14] Ne jamais committer de vraies valeurs dans ce fichier.
# Copier en .env.local et remplir avec les vraies valeurs.
# =========================================================================

# ---- AUTHENTIFICATION (post-P1, Neon + bcrypt + JWT) ----
# Générer avec : openssl rand -base64 32
JWT_SECRET=
# URL publique de l'app (sans slash final)
NEXTAUTH_URL=http://localhost:3000

# ---- BASE DE DONNÉES NEON ----
# Dashboard Neon → Connection string
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# ---- IA MISTRAL (post-P1-PR-06) ----
# Clé API serveur — ne jamais préfixer par NEXT_PUBLIC_
MISTRAL_API_KEY=
# Modèle Mistral par défaut
MISTRAL_MODEL=open-mistral-7b

# ---- GOOGLE DRIVE OAuth (optionnel, post-P2-PR-12) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- BASE DE DONNÉES NEON (post-P2-PR-19) ----
# Neon dashboard → Connection string
DATABASE_URL=

# ---- SENTRY (post-P2-PR-22) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- UPSTASH REDIS — rate limit (post-P2-PR-16) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- MAILGUN — emails transactionnels (post-P2) ----
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ---- CYPRESS (optionnel, pour enregistrement Cloud) ----
CYPRESS_RECORD_KEY=

# ---- CODECOV (optionnel, post-P2-PR-15) ----
CODECOV_TOKEN=

# ---- DÉVELOPPEMENT LOCAL SEULEMENT ----
# Active les logs détaillés en mode dev
NEXT_PUBLIC_DEBUG=false
